
{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Forest Green",
          "color": "#0B3D2B"
        },
        {
          "slug": "secondary",
          "name": "Strawberry Red",
          "color": "#C8102E"
        },
        {
          "slug": "accent",
          "name": "Strawberry Yellow",
          "color": "#FFD447"
        },
        {
          "slug": "leaf-green",
          "name": "Leaf Green",
          "color": "#347A36"
        },
        {
          "slug": "background",
          "name": "Warm White",
          "color": "#FAF9F6"
        },
        {
          "slug": "surface",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface-alt",
          "name": "Pale Green",
          "color": "#EEF4E9"
        },
        {
          "slug": "text",
          "name": "Charcoal",
          "color": "#202624"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Montserrat', sans-serif",
          "name": "Montserrat",
          "slug": "heading"
        },
        {
          "fontFamily": "'Inter', sans-serif",
          "name": "Inter",
          "slug": "body"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "13px"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "16px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "18px"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "24px"
        },
        {
          "slug": "xx-large",
          "name": "Section Heading",
          "size": "36px"
        },
        {
          "slug": "hero",
          "name": "Hero Heading",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        {"slug": "20", "name": "XS", "size": "8px"},
        {"slug": "30", "name": "Small", "size": "16px"},
        {"slug": "40", "name": "Medium", "size": "24px"},
        {"slug": "50", "name": "Large", "size": "40px"},
        {"slug": "60", "name": "XL", "size": "64px"},
        {"slug": "70", "name": "XXL", "size": "96px"}
      ],
      "blockGap": "0"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
        "blockGap": "0"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "#FFFFFF"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "700",
          "fontSize": "15px"
        },
        "border": {
          "radius": false
        }
      }
    }
  }
}
